# ClipForge Environment Configuration
# Copy to .env and fill in your values.

# Optional: Google Gemini free-tier API key (https://aistudio.google.com/apikey)
# If omitted, ClipForge falls back to heuristic scoring and template metadata.
GEMINI_API_KEY=

# Fast Gemini model (free tier compatible)
GEMINI_MODEL=gemini-3.5-flash

# Local storage directory (relative to project root or absolute)
CLIPFORGE_DATA_DIR=./data

# Max video duration allowed in minutes
CLIPFORGE_MAX_DURATION_MINUTES=90

# Default faster-whisper model: tiny, base, small, medium, large-v3
CLIPFORGE_WHISPER_MODEL=small

# Backend / Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: YouTube cookies for yt-dlp if YouTube asks you to sign in
# Use one or a comma-separated fallback list of browsers (chrome, safari, firefox, brave, edge)
# OR a path to an exported Netscape cookies.txt file.
YT_DLP_COOKIES_FROM_BROWSER=
YT_DLP_COOKIES_FILE=
